<% content_for :title, "Sueldo base" %>

<div class="page-header">
  <div>
    <h1>Sueldo base de <%= @technician.nombre_completo %></h1>
    <p class="muted">El bono de este técnico será el porcentaje de su escalón aplicado a este sueldo.</p>
  </div>
</div>

<%= form_with model: @technician, url: empresa_technician_path(@technician), method: :patch, class: "form card" do |f| %>
  <%= render "shared/errores", record: @technician %>

  <div class="field">
    <%= f.label :sueldo_base, "Sueldo base mensual (USD)" %>
    <%= f.number_field :sueldo_base, required: true, min: 0.01, max: 100000, step: 0.01, placeholder: "500.00" %>
  </div>

  <% if @escalones.any? %>
    <div class="field">
      <span class="label">Así quedarían sus bonos</span>
      <ul class="tiers">
        <% @escalones.each do |escalon| %>
          <li class="tier"><strong><%= escalon.nombre %></strong> <span><%= porcentaje(escalon.porcentaje) %></span>
            <b><%= @technician.sueldo_base ? number_to_currency(escalon.monto_para(@technician.sueldo_base)) : "—" %></b></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="actions">
    <%= f.submit "Guardar sueldo base", class: "btn btn--primary" %>
    <%= link_to "Cancelar", empresa_technicians_path, class: "btn" %>
  </div>
<% end %>
