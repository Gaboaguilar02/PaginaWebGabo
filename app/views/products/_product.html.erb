<div id="<%= dom_id product %>">
  <div>
    <strong>Nombre:</strong>
    <%= product.nombre %>
  </div>

  <div>
    <strong>Descripcion:</strong>
    <%= product.descripcion %>
  </div>

  <div>
    <strong>Precio:</strong>
    <%= product.precio %>
  </div>

  <div>
    <strong>Stock:</strong>
    <%= product.stock %>
  </div>

</div>
