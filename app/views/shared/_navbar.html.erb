<header class="topbar">
  <div class="topbar__inner">
    <%= link_to image_tag("logo-ufix-nav.png", alt: "UFix", class: "brand__logo"), (current_user.admin? ? admin_root_path : (current_user.cliente? ? cliente_root_path : (current_user.empresa? ? empresa_root_path : (current_user.tecnico? ? tecnico_root_path : root_path)))), class: "brand" %>

    <nav class="topnav">
      <% if current_user.admin? %>
        <%= nav_link "Panel", admin_root_path %>
        <%= nav_link "Empresas", admin_companies_path %>
        <%= nav_link "Usuarios", admin_users_path %>
        <%= nav_link "Electrodomésticos", admin_appliance_types_path %>
        <%= nav_link "Provincias", admin_provinces_path %>
        <%= nav_link "Ciudades", admin_cities_path %>
      <% end %>
      <% if current_user.cliente? %>
        <%= nav_link "Mis solicitudes", cliente_root_path, activo: request.path != new_cliente_repair_case_path %>
        <%= nav_link "Solicitar servicio", new_cliente_repair_case_path %>
      <% elsif current_user.empresa? %>
        <%= nav_link "Panel", empresa_root_path %>
        <%= nav_link "Solicitudes", empresa_repair_cases_path %>
        <%= nav_link "Ranking", empresa_ranking_path %>
        <%= nav_link "Técnicos", empresa_technicians_path %>
        <%= nav_link "Bonos", empresa_bonus_tiers_path %>
        <%= nav_link "Pagos", empresa_bonus_payments_path %>
      <% elsif current_user.tecnico? %>
        <%= nav_link "Mi panel", tecnico_root_path %>
        <%= nav_link "Mis casos", tecnico_repair_cases_path %>
        <%= nav_link "Mi desempeño", tecnico_desempeno_path %>
      <% else %>
        <%= nav_link "Productos", products_path %>
      <% end %>
    </nav>

    <div class="topbar__user">
      <span><%= current_user.nombre_completo.presence || current_user.username %> · <%= current_user.role_label %></span>
      <%= button_to "Cerrar sesión", logout_path, method: :delete, class: "btn btn--light btn--sm" %>
    </div>
  </div>
</header>
