<% content_for :title, "Solicitud ##{@repair_case.id}" %>

<div class="page-header">
  <div>
    <h1>Solicitud #<%= @repair_case.id %> · <%= @repair_case.appliance_type.nombre %> <%= badge_estado_caso(@repair_case) %></h1>
    <p class="muted">Enviada el <%= l @repair_case.created_at.to_date, format: :long %></p>
  </div>
  <div class="actions">
    <% if @repair_case.cancelable? %>
      <%= button_to "Cancelar solicitud", cancelar_cliente_repair_case_path(@repair_case), method: :patch,
                    class: "btn btn--danger", form: { data: { turbo_confirm: "¿Cancelar esta solicitud?" } } %>
    <% end %>
    <%= link_to "Volver", cliente_root_path, class: "btn" %>
  </div>
</div>

<div class="card">
  <h2>Avance del servicio</h2>
  <%= render "shared/timeline", repair_case: @repair_case %>
</div>

<div class="grid-2">
  <div class="card">
    <h2>Detalle de la solicitud</h2>
    <dl class="details">
      <dt>Problema</dt><dd><%= simple_format(h(@repair_case.falla)) %></dd>
      <dt>Dirección</dt><dd><%= @repair_case.direccion %></dd>
      <dt>Ciudad</dt><dd><%= @repair_case.city.nombre %>, <%= @repair_case.city.province.nombre %></dd>
    </dl>
  </div>

  <div class="card">
    <h2>Empresa y técnico</h2>
    <dl class="details">
      <dt>Empresa</dt><dd><%= @repair_case.company.nombre %></dd>
      <dt>Teléfono</dt><dd><%= @repair_case.company.telefono.presence || "—" %></dd>
      <dt>Reputación</dt>
      <dd><%= @repair_case.company.reviews_count.zero? ? "Sin calificaciones" : "#{estrellas(@repair_case.company.rating_promedio.round)} #{@repair_case.company.rating_promedio} (#{@repair_case.company.reviews_count})" %></dd>
      <dt>Técnico</dt><dd><%= @repair_case.technician&.nombre_completo || "Aún sin asignar" %></dd>
    </dl>
  </div>
</div>

<% if @repair_case.evidencias.attached? %>
  <div class="card">
    <h2>Evidencias</h2>
    <div class="gallery">
      <% @repair_case.evidencias.each do |evidencia| %>
        <%= link_to url_for(evidencia), target: "_blank", rel: "noopener" do %>
          <%= image_tag url_for(evidencia), alt: "Evidencia del daño", class: "gallery__img" %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<% if @repair_case.puede_calificar? %>
  <div class="card" id="feedback">
    <h2>Califica el servicio</h2>
    <p class="muted">Tu opinión mide el desempeño del técnico y la reputación de la empresa.</p>
    <%= form_with url: calificar_cliente_repair_case_path(@repair_case), method: :patch, class: "form" do %>
      <div class="field">
        <span class="label">Calificación</span>
        <div class="checks">
          <% 5.downto(1) do |puntaje| %>
            <label class="check">
              <%= radio_button_tag :calificacion, puntaje, false, required: true %>
              <%= estrellas(puntaje) %> <%= { 5 => "Excelente", 4 => "Muy bueno", 3 => "Bueno", 2 => "Regular", 1 => "Malo" }[puntaje] %>
            </label>
          <% end %>
        </div>
      </div>
      <div class="field">
        <%= label_tag :comentario_feedback, "Comentario (opcional)" %>
        <%= text_area_tag :comentario_feedback, nil, rows: 3, maxlength: 500, placeholder: "¿Fue puntual? ¿Resolvió el problema? ¿Cómo fue el trato?" %>
      </div>
      <%= submit_tag "Enviar calificación", class: "btn btn--primary" %>
    <% end %>
  </div>
<% elsif @repair_case.calificado? %>
  <div class="card" id="feedback">
    <h2>Tu calificación</h2>
    <p class="rating"><%= estrellas(@repair_case.calificacion) %> <span class="muted"><%= @repair_case.calificacion %> de 5 · <%= l @repair_case.feedback_at.to_date, format: :long %></span></p>
    <% if @repair_case.comentario_feedback.present? %>
      <p>“<%= @repair_case.comentario_feedback %>”</p>
    <% end %>
  </div>
<% end %>
